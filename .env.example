# Copy to .env for local (non-Docker) development.
# docker-compose.yml sets these itself and does not read this file.

# --- database ---------------------------------------------------------------
POSTGRES_USER=codonlab
POSTGRES_PASSWORD=codonlab
POSTGRES_DB=codonlab

# Host port the compose Postgres is published on. 5432 is left alone because it
# is so often already taken; change this if 5433 clashes too. Services inside
# the compose network are unaffected — they reach Postgres on 5432 by name.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://codonlab:codonlab@localhost:5433/codonlab

# --- jobs -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- api --------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Providers available to the run pipeline. Until Phase 6 ships real predictors the
# only implementation is MockProvider, which forces demo mode on across the product:
# a persistent amber bar, a badge on every number it produced, watermarked exports,
# and a refusal to generate primers.
CODONLAB_PROVIDERS=mock

# --- goal parsing -----------------------------------------------------------
# Used only to turn a free-text engineering goal into the structured objective
# shown back as editable chips. It never produces a scientific number, and no
# run can start from a parse the user has not confirmed.
#
# Leave blank to use the deterministic fallback parser: no network, fully
# reproducible, and every parse it produces is badged as rule-based so it is
# never mistaken for a reading of the sentence you actually wrote.
ANTHROPIC_API_KEY=
CODONLAB_PARSER_MODEL=claude-opus-5

# --- web --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
